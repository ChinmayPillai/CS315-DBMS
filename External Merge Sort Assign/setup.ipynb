    "import random\n",
    "\n",
    "n = 10000\n",
    "random_numbers = [random.randint(0, 1000000) for _ in range(n)]\n",
    "\n",
    "with open('input-file.txt', 'w') as file:\n",
    "    for number in random_numbers:\n",
    "        file.write(f\"{number}\\n\")"
